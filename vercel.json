{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "plateforme-revenus.vercel.app" }],
      "destination": "https://plateforme-revenus.jercat.fr/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "plateforme-revenus.vercel.app" }],
      "destination": "https://plateforme-revenus.jercat.fr/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://d-veloppeur-web-ind-pendant-votre-s.vercel.app https://dev.jercat.fr" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
